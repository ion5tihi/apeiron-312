<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/widget_bg_start"
                android:endColor="@color/widget_bg_end"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_weather_clear"
        android:gravity="center" />
</layer-list>
