<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_weather_icon"
            android:src="@drawable/ic_weather_clear" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="14°"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/widget_feels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                tools:text="Відчувається як 12°"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            tools:text="14:32"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/alert_background"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="❄ Приморозки вночі: -2°"
        tools:visibility="visible"
        xmlns:tools="http://schemas.android.com/tools" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <TextView
            android:id="@+id/widget_metric_humidity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            tools:text="💧 78%"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/widget_metric_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            tools:text="💨 4 м/с"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/widget_metric_precip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            tools:text="🌧 0.2мм"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/widget_metric_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            tools:text="🌙 +3°"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        tools:text="Можна провітрити: тепло і безвітряно"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
